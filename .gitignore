# Public repository uses an explicit allowlist. Everything else stays local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/docs/
!/px4_rtl_land_validation/

/docs/*
!/docs/BASELINE.md
!/docs/COLLABORATION.md

/px4_rtl_land_validation/*
!/px4_rtl_land_validation/validate.py
!/px4_rtl_land_validation/analyze.py

# Defense in depth for source documents, CAD, CFD, logs and local environments.
**/.venv/
**/__pycache__/
**/PX4-Autopilot/
**/private_review/
**/logs/
**/parameters/
**/manual_session/
*.doc
*.docx
*.pdf
*.step
*.STEP
*.stp
*.sldasm
*.sldprt
*.sim
*.ulg
*.bson
*.tlog
*.zip
*.mp4
*.webm
.env
.env.*
*.pem
*.key
